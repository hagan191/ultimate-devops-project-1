pipeline {
    agent any

    tools {
        go 'go-1.22'
    }

    environment {
        GIT_REPO = "https://github.com/himansu2046/ultimate-devops-project-demo.git"
        // Define DOCKER_USER at environment level
        DOCKER_USER = 'himansu2046'
    }

    stages {

        // 1. Workspace Cleanup (FIRST)
        stage('Workspace Cleanup') {
            steps {
                cleanWs()
            }
        }

        // 2. Checkout Code
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: "${GIT_REPO}",
                    credentialsId: 'github-credentials'
            }
        }

        // 3. OWASP Dependency Check (AFTER CHECKOUT)
        stage('OWASP Dependency Check') {
            steps {
                dependencyCheck additionalArguments: '--scan ./ --format XML',
                                 odcInstallation: 'OWASP-DC'
                dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
            }
        }

        // 4. Trivy Filesystem Scan (BEFORE BUILD)
        stage('Trivy FS Scan') {
            steps {
                sh '''
                trivy fs --severity HIGH,CRITICAL --no-progress .
                '''
            }
        }

        // 5. Build
        stage('Build') {
            steps {
                sh '''
                cd src/product-catalog
                go mod download
                go build -o product-catalog-service main.go
                '''
            }
        }

        // 6. Unit Tests
        stage('Unit Tests') {
            steps {
                sh '''
                cd src/product-catalog
                go test ./...
                '''
            }
        }

        // 7. Code Quality (Lint)
        stage('Code Quality (golangci-lint)') {
            steps {
                sh '''
                curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh | sh -s v1.55.2
                export PATH=$PATH:$(pwd)/bin

                cd src/product-catalog
                golangci-lint run || echo "Lint issues found, continuing..."
                '''
            }
        }

        // 8. SonarQube Analysis
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube-server') {
                    sh '''
                    cd src/product-catalog
                    sonar-scanner \
                      -Dsonar.projectKey=product-catalog \
                      -Dsonar.sources=.
                    '''
                }
            }
        }

        // 9. Sonar Quality Gate
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // 10. Docker Login
        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh 'echo "$DOCKER_PASS" | docker login -u "$DOCKER_USERNAME" --password-stdin'
                }
            }
        }

        // 11. Docker Build
        stage('Docker Build') {
            steps {
                script {
                    // Use DOCKER_USERNAME from credentials or the environment variable
                    def IMAGE = "${DOCKER_USER}/product-catalog:${BUILD_ID}"
                    env.DOCKER_IMAGE = IMAGE

                    sh "docker build -t ${IMAGE} src/product-catalog"
                }
            }
        }

        // 12. Docker Push
        stage('Docker Push') {
            steps {
                sh "docker push ${DOCKER_IMAGE}"
            }
        }

        // 13. Update Kubernetes Manifest
        stage('Update K8s Manifest') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-credentials',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_PASS'
                )]) {
                    sh '''
                    git config --global user.email "himansu2046@gmail.com"
                    git config --global user.name "Himansu Biswal"

                    sed -i "s|image: .*|image: ${DOCKER_IMAGE}|" kubernetes/productcatalog/deploy.yaml

                    git add kubernetes/productcatalog/deploy.yaml
                    git commit -m "[CI]: Update product catalog image tag [skip ci]" || echo "No changes"

                    git push https://${GIT_USER}:${GIT_PASS}@github.com/himansu2046/ultimate-devops-project-demo.git HEAD:main
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
